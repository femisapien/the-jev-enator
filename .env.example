# Copy to .env and add your key, then run ./install.sh
#
# install.sh reads the key from here and copies it into ~/.claude/settings.json,
# which is where the hook process can actually see it. This file is only used for
# install and for running tests/test_jev_gate.py directly.
#
# Never commit .env — it is gitignored.

export TYPESAFE_API_KEY=""

# Audit log: one JSONL line per classification with scores, latency, and tokens.
# Keep this identical to the JEV_GATE_LOG that install.sh writes into
# settings.json, or tests and real sessions will log to different files and
# report.sh will only see one of them.
export JEV_GATE_LOG="$HOME/jev-gate.jsonl"

# Set to 1 to bypass the gate entirely.
# export JEV_GATE_DISABLE=1
