# Copy to .env and fill in. Source it before testing:  source .env
export TYPESAFE_API_KEY=""

# Optional: audit log of every classification (scores, latency, token usage)
export JEV_GATE_LOG="$HOME/jev-gate/jev-gate.jsonl"

# Optional: set to 1 to bypass the gate entirely
# export JEV_GATE_DISABLE=1
